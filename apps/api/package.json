{
  "name": "@hvl-info/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/mvp-server.ts",
    "start": "node --env-file=.env dist/mvp-server.js",
    "dev:legacy": "node --env-file=.env --import tsx --watch src/server.ts",
    "start:legacy": "node --env-file=.env dist/server.js",
    "build": "tsc -p tsconfig.json",
    "db:migrate": "node --env-file=.env --import tsx src/migrate.ts"
  },
  "dependencies": {
    "@hvl-info/contracts": "0.1.0",
    "express": "^4.21.0",
    "jose": "^5.9.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
