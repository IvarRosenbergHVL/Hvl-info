# Copy to apps/api/.env; never commit real credentials.
PORT=3000
API_HOST=127.0.0.1
DATABASE_URL=postgres://hvl_info:hvl_info_local_only@localhost:5432/hvl_info

# UUID flashed into every MVP ESP32-S3 beacon. Major is fixed to 1; Minor = beacon number.
# UUID used in the four Arduino test sketches; change only if you reflashed all boards.
HVL_IBEACON_UUID=12345678-1234-1234-1234-1234567890ab

# Leave blank for localhost-only development. Required (>=16 chars) if API_HOST is exposed
# beyond localhost or NODE_ENV=production. Entra ID will replace this temporary admin key later.
ADMIN_API_KEY=

# Legacy Entra-backed API settings are kept for src/server.ts only.
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
ENTRA_ADMIN_ROLE=HvlInfo.Admin
ENTRA_USER_SCOPE=HvlInfo.Read
