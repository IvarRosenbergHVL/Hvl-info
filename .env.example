# Copy to apps/api/.env or export in your shell; never commit real credentials.
PORT=3000
DATABASE_URL=postgres://hvl_info:hvl_info_local_only@localhost:5432/hvl_info
ENTRA_TENANT_ID=
# Audience must exactly match the access-token aud issued for HVL Info API.
ENTRA_API_AUDIENCE=
ENTRA_ADMIN_ROLE=HvlInfo.Admin
ENTRA_USER_SCOPE=HvlInfo.Read
# A UUID allocated to the HVL Info iBeacon namespace; not an authentication secret.
HVL_IBEACON_UUID=
